# 复制为 .env 后填写。真 .env 不提交（见 .gitignore）。
# 注意：DATABASE_URL 的 host 用 compose 服务名 db，端口 5432（容器内网络）。
DATABASE_URL=postgresql+psycopg://app:app@db:5432/imitator
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
ANTHROPIC_API_KEY=sk-ant-...   # 生产经 Secret Manager 注入，勿提交真实值

# 走真实 Anthropic 生成管线；false 时用离线桩，不产生 token 费用。
# 需与非空 ANTHROPIC_API_KEY 同时满足才生效（见 routers/variants.py）。
USE_REAL_LLM=false

# 后台定时抓取已启用的 RSS 源（APScheduler）；本地开发建议保持 false。
CRAWL_SCHEDULER_ENABLED=false
