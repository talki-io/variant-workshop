# 复制为 deploy/.env 后填写，然后 chmod 600 deploy/.env。真 .env 不提交（见根 .gitignore）。
#
# 这一个文件有两个身份：
#   1. docker compose 的变量插值源（${POSTGRES_PASSWORD} 等）
#   2. backend 容器的环境变量来源（env_file）
#
# 不要在这里写 DATABASE_URL —— compose 会用下面的用户名/密码/库名自行组装，
# 免得改了密码忘了改 URL。也不要写 SEED_DEMO_DATA —— compose 已硬设为 false。

# ---- Postgres ----
POSTGRES_USER=app
# 用 `openssl rand -base64 24` 生成，别用开发栈的 app/app。
POSTGRES_PASSWORD=
# 保留 imitator：迁移与既有卷都按这个名字（项目改名时刻意没动库名）。
POSTGRES_DB=imitator

# ---- 鉴权 ----
# 用 `openssl rand -hex 32` 生成。留占位值的话 backend 启动时会告警。
# 换掉它会让所有已签发的 JWT 立即失效（用户需重新登录），这是预期行为。
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# ---- Anthropic ----
# 单机部署直接填这里（文件 600）。上云请改走 Secret Manager 注入环境变量，别落盘。
ANTHROPIC_API_KEY=

# 走真实 Anthropic 生成管线。false 时用离线桩，不产生 token 费用。
# 需与非空 ANTHROPIC_API_KEY 同时满足才生效（见 routers/variants.py）。
USE_REAL_LLM=true

# 后台每 15 分钟抓一轮启用的源（APScheduler，进程内）。
# 开启即产生真实抓取流量；USE_REAL_LLM=true 时还会顺带 Haiku 富化，**这会花钱**。
# 想先观察一段时间再放开，就填 false，改用「抓取源」页手动触发。
CRAWL_SCHEDULER_ENABLED=true

# ---- 对外暴露 ----
# 默认只绑回环。改成 0.0.0.0:8080 前，先在前面放一层终结 TLS 的反代——
# 这个栈自己不做 HTTPS，JWT 明文过公网等于没有鉴权。
HTTP_BIND=127.0.0.1:8080
